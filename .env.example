# Facebook Creator Agent — example configuration.
# Copy to `.env` and fill in your own values. Every value below is a placeholder.
# The loader accepts KEY=VALUE lines, `#` comments, and optional surrounding quotes.
# Secrets belong in this file (which is git-ignored) or in real environment variables.

# ---------------------------------------------------------------- base / workspace
# Base directory used to resolve `workspace/` and `config.local.json`.
# Set this explicitly when the server is launched by a tool that controls its CWD.
#FCA_BASE_DIR=C:/Users/you/facebook_creator_agent_docs
#FCA_WORKSPACE_ROOT=workspace
#FCA_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------ LLM
# Required for script/metadata generation. Any OpenAI-compatible chat endpoint.
#FCA_LLM_BASE_URL=https://api.example.com/v1
#FCA_LLM_MODEL=your-model-name
#FCA_LLM_API_KEY=replace-me
#FCA_LLM_TIMEOUT_SECONDS=60
#FCA_LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------- research
# Optional topic-research provider; leaving it unset makes research unavailable.
#FCA_RESEARCH_BASE_URL=https://research.example.com
#FCA_RESEARCH_API_KEY=replace-me

# ------------------------------------------------------------------------------ TTS
# Optional command-based narration engine. JSON argv template.
# Tokens: {text_file} {output} {voice} {language}.
# Without a {text_file}/{output} token, the input file and output path are appended
# as the last two arguments.
#FCA_TTS_COMMAND_JSON=["my-tts-engine","--input","{text_file}","--out","{output}"]
#FCA_TTS_OUTPUT_EXTENSION=wav

# ---------------------------------------------------------------------------- media
# Provider allow-list (default-deny policy). Known providers: fixture, pexels.
#FCA_MEDIA_ALLOWED_PROVIDERS=fixture,pexels
# Licenses accepted for automatic use (exact, case-insensitive allow-list match).
# Known values: CC0-1.0, CC-BY-4.0, CC-BY-3.0, PUBLIC-DOMAIN,
#               USER-SUPPLIED-CONFIRMED, PEXELS-LICENSE
#FCA_MEDIA_ALLOWED_LICENSES=CC0-1.0,CC-BY-4.0,CC-BY-3.0,PUBLIC-DOMAIN,USER-SUPPLIED-CONFIRMED,PEXELS-LICENSE
# Only needed to use the (experimental, unverified-live) Pexels provider.
#FCA_PEXELS_API_KEY=replace-me
#FCA_MEDIA_MAX_DOWNLOAD_MB=200
#FCA_MEDIA_MAX_REDIRECTS=3
# Directory of operator-supplied fixture assets (offline provider; no network).
#FCA_FIXTURE_MEDIA_DIR=C:/path/to/fixture/assets

# -------------------------------------------------------------------------- render
#FCA_FFMPEG_PATH=ffmpeg
#FCA_FFPROBE_PATH=ffprobe
#FCA_RENDER_FPS=30
#FCA_RENDER_MAX_DURATION_SECONDS=180
#FCA_RENDER_TIMEOUT_SECONDS=600

# ------------------------------------------------------------------------- facebook
# Live publishing is OFF unless BOTH a token is present AND the gate below is true.
# Uploads are always preceded by a human approval created through the review flow.
#FCA_FACEBOOK_ACCESS_TOKEN=replace-me
#FCA_FACEBOOK_PAGE_ID=1234567890
#FCA_FACEBOOK_GRAPH_VERSION=v23.0
#FCA_ENABLE_LIVE_PUBLISH=false
# Endpoint overrides — leave unset for production; used by tests against a local fake.
#FCA_FACEBOOK_GRAPH_BASE_URL=https://graph.facebook.com
#FCA_FACEBOOK_GRAPH_VIDEO_BASE_URL=https://graph-video.facebook.com
